subport libpurple3 {
    dist_subdir             ${name}/${version}

    depends_lib-append      port:birb \
                            port:gplugin \
                            port:gstreamer1 \
                            port:hasl \
                            port:json-glib \
                            port:libsoup \
                            port:pango \
                            port:seagull \
                            port:tcl \
                            port:tk

    configure.args          -Dgtkui=false
}

if {${subport} eq $name} {
    dist_subdir             ${name}/${version}

    depends_lib-append      port:gtk4 \
                            port:gtksourceview5 \
                            port:libadwaita

    post-activate {
        system "${prefix}/bin/glib-compile-schemas ${prefix}/share/glib-2.0/schemas"
        system "${prefix}/bin/gtk4-update-icon-cache -f -t ${prefix}/share/icons/hicolor"
    }
}

if {${subport} ne "libpurple3"} {
    post-destroot {
        foreach file [glob -nocomplain -directory ${destroot}${prefix}/share/locale/ */LC_MESSAGES/pidgin3.mo] {
            delete $file
        }
        foreach file [glob -nocomplain -directory ${destroot}${prefix}/lib pkgconfig/purple-3.pc girepository-1.0/Purple-3.0.typelib libpurple3* purple-3] {
            delete $file
        }
        delete  ${destroot}${prefix}/include/purple-3 \
                ${destroot}${prefix}/share/gir-1.0/Purple-3.0.gir \
                ${destroot}${prefix}/share/glib-2.0/schemas/im.pidgin.Purple.gschema.xml
    }
}

livecheck.type      regex
livecheck.url       http://sourceforge.net/projects/pidgin/files/Pidgin3/
livecheck.regex     "\/Pidgin3\/(\\d+(?:\\.\\d+)*)\/"

notes "
This is an experimental version of Pidgin, libpurple or its dependencies, or a library that's mostly used by it.
A lot of core features, including creating a direct message is not available yet.
I think you already know this if you came to my downstream macports-ports instead of the upstream.
Please don't bother the developers too much...
"
